{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "outDir": "./dist"
    },
    "include": [
        "apps/**/*",
        "packages/**/*",
        "services/**/*"
    ],
    "exclude": [
        "**/dist",
        "**/node_modules"
    ]
}